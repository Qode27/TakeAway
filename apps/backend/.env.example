NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_hub
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
DEFAULT_TIMEZONE=Europe/Dublin
STORE_NAME=Dublin Kebab House
STORE_CURRENCY=EUR
UBER_EATS_WEBHOOK_SECRET=dev-uber-secret
TRUST_PROXY=1
ENABLE_BACKGROUND_WORKERS=true
ENABLE_EMAIL_POLLING=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=120
EMAIL_FALLBACK_ENABLED=true
EMAIL_HOST=imap.example.com
EMAIL_PORT=993
EMAIL_USER=orders@example.com
EMAIL_PASSWORD=change-me
EMAIL_TLS=true
EMAIL_POLL_INTERVAL_MS=30000
SANITIZE_LOGS=true
